<%# Print key ticket, in an appointment's top-right actions; opens the print dialog %>
<%= link_to new_key_ticket_path(appointment_id: appointment.id), remote: true, class: 'qbo-ticket-print-link',
            title: l(:button_qbo_tickets_print) do %>
  <i class="fa-solid fa-receipt"></i> <%= l(:button_qbo_tickets_print) %>
<% end %>
